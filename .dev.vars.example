# Optional. `pnpm dev` runs without this file: it supplies its own dev values
# for SESSION_SECRET, GITHUB_WEBHOOK_SECRET and ENABLE_DEBUG_ROUTES, and you
# sign in through /auth/dev-login instead of GitHub. Copy this to .dev.vars
# (gitignored) when you want local dev wired to a real GitHub App — anything
# set here wins over the dev values. Plain vars live in wrangler.toml [vars];
# only secrets and local overrides go here. See docs/setup.md.

# Unlocks /auth/dev-login and /api/debug/*, which fabricate sessions and runs
# without GitHub. `pnpm dev` sets this for its own worker already.
ENABLE_DEBUG_ROUTES=1

# From the GitHub App / OAuth App that matches GITHUB_OAUTH_CLIENT_ID.
GITHUB_OAUTH_CLIENT_SECRET=

# Any long random string; signs session cookies. `openssl rand -hex 32`.
SESSION_SECRET=

# Shared secret configured on the GitHub webhook (docs/setup.md). The
# /webhook/github route returns 503 until this is set.
GITHUB_WEBHOOK_SECRET=

# Only needed when RUNNER_PROVIDER = "digitalocean". A DO personal access
# token with droplet read/write scope.
# DO_API_TOKEN=

# Optional. Lifts GitHub API rate limits for pipeline stage-hashing
# (docs/pipeline.md); without it hashing degrades to coarse rebuilds.
# GITHUB_API_TOKEN=

# Hosted preview environments (docs/preview-environments.md). Unset, a repo
# declaring a `preview` block fails its runs with that as the reason; "stub"
# resolves one locally without calling either service.
# PREVIEW_PROVIDER=stub
# SUPABASE_ACCESS_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
